DKO_LISTEN_ADDR=127.0.0.1:8095
DKO_ENV=development
DKO_POLL_MINUTES=5
DKO_DATABASE_TIMEOUT_SECONDS=5
DKO_DATABASE_URL=postgres://deskaone:ganti-password@127.0.0.1:5439/deskaone_control?sslmode=disable
DKO_COOKIE_SECURE=false
# Wajib 32 byte dalam base64. Contoh PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
DKO_MASTER_KEY=
# Hanya untuk bootstrap pertama; hapus dari .env setelah admin berhasil dibuat.
DKO_BOOTSTRAP_ADMIN_USERNAME=admin
DKO_BOOTSTRAP_ADMIN_PASSWORD=
# Transisi legacy opsional untuk account_key=default saja. Jangan dipindahkan otomatis ke DB.
# DKO_PROXYRACK_API_KEY=...
# DKO_REPOCKET_EMAIL=...
# DKO_REPOCKET_PASSWORD=...
# DKO_TRAFFMONETIZER_TOKEN=...
# Do not commit your .env

# compose.yaml
POSTGRES_DB=deskaone_control
POSTGRES_USER=deskaone
POSTGRES_PASSWORD=
